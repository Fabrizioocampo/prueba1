          "text": [
            "M=0, error: 0.60791, w-norm: 0.00000\n",
            "M=1, error: 0.24928, w-norm: 1.97698\n",
            "M=2, error: 0.25028, w-norm: 1.87149\n",
            "M=3, error: 0.06685, w-norm: 43.38255\n",
            "M=4, error: 0.06667, w-norm: 34.24395\n",
