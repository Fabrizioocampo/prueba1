      "source": [
        "from sklearn.linear_model import Ridge\n",
        "\n",
        "train_errors = []\n",
        "test_errors = []\n",
        "w_norm = []\n",
        "degrees = np.arange(0,11)\n",
        "for degree in degrees:\n",
        "    # entrenar el modelo\n",
        "    #model = make_pipeline(PolynomialFeatures(degree), Ridge(0.01))\n",
        "    model = make_pipeline(PolynomialFeatures(degree), LinearRegression())\n",
        "    model.fit(X_train, y_train)\n",
        "\n",
        "    # predecir las salidas\n",
        "    y_train_pred = model.predict(X_train)\n",
        "    y_test_pred = model.predict(X_test)\n",
        "\n",
        "    # calcular los errores\n",
        "    train_error = mean_squared_error(y_train, y_train_pred)\n",
        "    test_error = mean_squared_error(y_test, y_test_pred)\n",
        "    train_errors.append(train_error)\n",
        "    test_errors.append(test_error)\n",
        "\n",
        "    # norma de los coeficientes\n",
        "    wnorm = np.linalg.norm(model.steps[1][1].coef_)\n",
        "    w_norm.append(wnorm)\n",
        "\n",
        "    print(f\"M={degree}, error: {test_error:.5f}, w-norm: {wnorm:.5f}\")"
      ]
